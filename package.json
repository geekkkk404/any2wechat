{
  "name": "any2wechat",
  "version": "0.4.2",
  "description": "任意项目，一条 HTTP 请求，直达个人微信。/ A push bridge: any HTTP project → your personal WeChat.",
  "type": "module",
  "main": "src/main.mjs",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "bin": {
    "any2wechat-login": "bin/login.mjs",
    "any2wechat-send": "bin/send-test.mjs"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "login": "node bin/login.mjs",
    "send-test": "node bin/send-test.mjs",
    "test": "node --test test/relay.test.mjs test/images.test.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "wechat",
    "ilink",
    "webhook",
    "notification",
    "bridge",
    "push"
  ],
  "author": "GeeKKKK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekkkk404/any2wechat.git"
  }
